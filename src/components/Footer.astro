---
/**
 * Footer — CTA + 4 colonne (Studio, Naviga, Servizi, Progetti) + social + logo.
 * Contenuti da data/site, nav, services, projects (tutti segnaposto).
 */
import { site } from '../data/site';
import { footerNav } from '../data/nav';
import { services } from '../data/services';
import { projects } from '../data/projects';

const year = new Date().getFullYear();
const footerProjects = projects.slice(0, 6);
---
<footer id="site-footer" class="relative overflow-hidden bg-ink text-white/85">
  <!-- CTA -->
  <section class="relative z-10 container-site pt-20 pb-14 md:pt-28 md:pb-20">
    <div class="grid md:grid-cols-12 gap-8 items-end reveal-in">
      <div class="md:col-span-8">
        <p class="eyebrow mb-3">Iniziamo</p>
        <h2 class="font-heading text-h1 leading-[1.02] max-w-3xl text-white">Parliamo del tuo progetto.</h2>
        <p class="mt-m max-w-xl text-white/70">Raccontaci come immagini i tuoi spazi. Fissiamo un primo confronto e valutiamo insieme esigenze, tempi e budget.</p>
      </div>
      <div class="md:col-span-4 flex flex-wrap gap-3 md:justify-end">
        <a href="/contatti/#richiedi" class="btn-primary">Contattaci</a>
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn-outline-light">WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- Nav columns -->
  <section class="relative z-10 container-site py-14 md:py-16 reveal-in">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
      <!-- Studio / contatti -->
      <div class="flex flex-col gap-3">
        <h3 class="text-xs uppercase tracking-[.22em] text-white/45 mb-1 font-semibold">Studio</h3>
        {site.addresses.map((a) => (
          <a href={a.mapsUrl} target="_blank" rel="noopener" class="text-sm text-white/75 hover:text-white transition-colors self-start">
            <span class="block text-white/45 text-xs uppercase tracking-wider">{a.label}</span>
            {a.full}
          </a>
        ))}
        <a href={`mailto:${site.email}`} class="text-sm text-white/75 hover:text-white transition-colors self-start">{site.email}</a>
        <a href={`tel:${site.phoneE164}`} class="text-sm text-white/75 hover:text-white transition-colors self-start">{site.phoneDisplay}</a>
      </div>

      <!-- Naviga -->
      <div class="flex flex-col gap-3">
        <h3 class="text-xs uppercase tracking-[.22em] text-white/45 mb-1 font-semibold">Naviga</h3>
        {footerNav.map((item) => (
          <a href={item.href} class="text-sm text-white/75 hover:text-white transition-colors self-start">{item.label}</a>
        ))}
      </div>

      <!-- Servizi -->
      <div class="flex flex-col gap-3">
        <h3 class="text-xs uppercase tracking-[.22em] text-white/45 mb-1 font-semibold">Servizi</h3>
        {services.map((s) => (
          <a href={`/servizi/#${s.slug}`} class="text-sm text-white/75 hover:text-white transition-colors self-start">{s.title}</a>
        ))}
      </div>

      <!-- Progetti -->
      <div class="flex flex-col gap-3">
        <h3 class="text-xs uppercase tracking-[.22em] text-white/45 mb-1 font-semibold">Progetti</h3>
        {footerProjects.map((p) => (
          <a href={`/portfolio/${p.slug}/`} class="text-sm text-white/75 hover:text-white transition-colors self-start">{p.title}</a>
        ))}
        <a href="/portfolio/" class="text-sm text-accent hover:text-white transition-colors self-start">Tutti i progetti →</a>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap gap-x-6 gap-y-2 items-center">
      <span class="text-xs uppercase tracking-[.22em] text-white/45">Seguici</span>
      {site.socials.map((s) => (
        <a href={s.url} target="_blank" rel="noopener" class="text-sm text-white/70 hover:text-accent transition-colors">{s.label}</a>
      ))}
    </div>
  </section>

  <!-- Logo + bottom -->
  <section class="relative z-10 container-site pb-12 md:pb-16">
    <div class="reveal-in">
      <a href="/" aria-label={`${site.name} — home`} class="inline-block">
        <img src="/images/logo/atelier-logo-white.png" alt={site.name} width="416" height="145" class="h-12 md:h-14 w-auto" />
      </a>
      <p class="mt-6 text-sm md:text-base text-white/80">Studio di architettura a Ravenna dal 2015.</p>
    </div>
    <div class="mt-12 flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-xs text-white/50">
      <p>© {year} {site.name}. Tutti i diritti riservati. · P.IVA {site.vat}</p>
      <div class="flex flex-wrap items-center gap-6">
        <a href="/privacy-policy/" class="hover:text-white transition-colors">Privacy</a>
        <a href="/cookie-policy/" class="hover:text-white transition-colors">Cookie</a>
        <a href={`mailto:${site.email}`} class="hover:text-white transition-colors">{site.email}</a>
      </div>
    </div>
  </section>
</footer>
