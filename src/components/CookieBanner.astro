---
/**
 * Cookie banner — appare una sola volta (localStorage). Nessun tracker viene
 * caricato: la scelta è solo memorizzata. Logica = script sorgente 1:1.
 */
---
<div
  id="cookie-banner"
  hidden
  class="fixed inset-x-0 bottom-0 z-[1000] bg-ink text-white/85"
  role="dialog"
  aria-live="polite"
  aria-label="Preferenze cookie"
>
  <div class="container-site py-5 flex flex-col md:flex-row md:items-center gap-4 md:gap-8">
    <p class="text-s text-white/80 flex-1">
      Questo sito usa cookie tecnici necessari al funzionamento. Continuando accetti l'uso dei cookie descritti nella
      <a href="/cookie-policy/" class="link-underline text-accent">Cookie policy</a>.
    </p>
    <div class="flex gap-3 shrink-0">
      <button type="button" data-cookie="reject" class="btn-outline-light !px-5 !py-2.5">Rifiuta</button>
      <button type="button" data-cookie="accept" class="btn-primary !px-5 !py-2.5">Accetta</button>
    </div>
  </div>
</div>

<script>
  const o="cookie-consent",e=document.getElementById("cookie-banner");try{e&&!localStorage.getItem(o)&&e.removeAttribute("hidden")}catch{}e?.querySelectorAll("[data-cookie]").forEach(t=>{t.addEventListener("click",()=>{try{localStorage.setItem(o,(t as HTMLElement).dataset.cookie??"reject")}catch{}e.setAttribute("hidden","")})});
</script>
