---
/**
 * ServiceIcon — icona a linea per servizio (tratto = currentColor, dettaglio
 * terracotta). Selezione per slug. Usata nella griglia servizi della home.
 */
interface Props { slug: string; class?: string; }
const { slug, class: className = '' } = Astro.props;

const icons: Record<string, string> = {
  'progettazione-architettonica':
    '<rect x="10" y="9" width="28" height="30" rx="2"/><path d="M10 17 h28"/><path d="M17 17 v22 M17 27 h9"/><path stroke="#e4572e" d="M27 24 v9 M23 33 h8"/>',
  'ristrutturazioni':
    '<path d="M10 30 L20 20 L28 28 L18 38 Z"/><path d="M25 23 l7 -7"/><path stroke="#e4572e" d="M30 12 l4 4 -3 3 -4 -4 z"/>',
  'interior-design':
    '<path d="M15 23 v-3 a3 3 0 0 1 3 -3 h12 a3 3 0 0 1 3 3 v3"/><path d="M13 23 a2 2 0 0 1 2 2 v5 h18 v-5 a2 2 0 0 1 2 -2"/><path d="M16 30 v6 M32 30 v6"/><path stroke="#e4572e" d="M19 27 h10"/>',
  'direzione-lavori':
    '<path d="M11 31 a13 13 0 0 1 26 0"/><path d="M8 31 h32"/><path stroke="#e4572e" d="M24 15 v5 M18 19 v3 M30 19 v3"/>',
  'render-3d':
    '<path d="M24 11 L37 18.5 L37 33.5 L24 41 L11 33.5 L11 18.5 Z"/><path stroke="#e4572e" d="M24 11 L24 26 M11 18.5 L24 26 L37 18.5"/>',
  'rti':
    '<path d="M15 8 h12 l8 8 v24 h-20 z"/><path d="M27 8 v8 h8"/><path stroke="#e4572e" d="M19 29 l4 4 7 -8"/>',
  'perizie-alluvione':
    '<path d="M13 23 L24 13 L35 23"/><path d="M16 21 v11 h16 v-11"/><path stroke="#e4572e" d="M11 35 q3.5 -3 7 0 t7 0 7 0"/>',
  'pratiche-catastali':
    '<path d="M11 13 h9 l3 4 h14 v22 h-26 z"/><path stroke="#e4572e" d="M17 27 h14 M17 33 h9"/>',
};
const inner = icons[slug] ?? '<circle cx="24" cy="24" r="12"/>';
---
<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true" set:html={inner}></svg>
