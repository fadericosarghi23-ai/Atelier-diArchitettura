---
/**
 * Placeholder immagine — sostituisce ogni foto/render reale mantenendo le
 * STESSE dimensioni (width/height/aspect-ratio), così animazioni e layout non
 * si spostano di un pixel. Renderizza un vero <img> con dentro un SVG grigio
 * (data URI) che mostra a schermo la misura e cosa rappresenta: gli hover e il
 * Ken Burns che agiscono sul selettore `img` continuano a funzionare.
 *
 * AL RIEMPIMENTO: sostituire <Placeholder .../> con <Image .../> (astro:assets)
 * o un <img> reale, mantenendo gli stessi w/h e le stesse classi.
 */
interface Props {
  w: number;
  h: number;
  label: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'sync' | 'async' | 'auto';
}
const {
  w, h, label,
  class: className = '',
  loading = 'lazy',
  fetchpriority = 'auto',
  decoding = 'async',
} = Astro.props;

const fs = Math.max(Math.round(Math.min(w, h) * 0.075), 18);
const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${w} ${h}" preserveAspectRatio="xMidYMid slice">
  <rect width="${w}" height="${h}" fill="#e7e0d7"/>
  <rect x="${fs}" y="${fs}" width="${w - fs * 2}" height="${h - fs * 2}" fill="none" stroke="#b7ab9c" stroke-width="${Math.max(2, Math.round(fs / 8))}" stroke-dasharray="${fs} ${fs * 0.8}"/>
  <g fill="#8a7e6f" font-family="ui-monospace,Menlo,Consolas,monospace" text-anchor="middle">
    <text x="${w / 2}" y="${h * 0.44}" font-size="${Math.round(fs * 0.7)}" letter-spacing="2">SEGNAPOSTO · DA SOSTITUIRE</text>
    <text x="${w / 2}" y="${h * 0.53}" font-size="${fs}" font-weight="600">${label}</text>
    <text x="${w / 2}" y="${h * 0.61}" font-size="${Math.round(fs * 0.85)}">${w}×${h}</text>
  </g>
</svg>`;
const src = `data:image/svg+xml,${encodeURIComponent(svg)}`;
---
<img
  src={src}
  width={w}
  height={h}
  alt={`DA COMPILARE: ${label}`}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding={decoding}
  class={className}
/>
