---
/** Intestazione standard delle pagine interne (eyebrow + titolo + intro). */
interface Props { eyebrow: string; title: string; intro?: string; }
const { eyebrow, title, intro } = Astro.props;
---
<section class="container-site pt-[calc(var(--header-h)+2.5rem)] pb-10 md:pb-14">
  <div class="max-w-3xl reveal-in">
    <p class="eyebrow mb-3">{eyebrow}</p>
    <h1 class="font-heading text-h1 text-ink">{title}</h1>
    {intro && <p class="mt-m text-body text-lg">{intro}</p>}
  </div>
</section>
