---
/** Fila di 5 stelle (SVG inline), colore currentColor. */
interface Props { size?: number; label?: string; class?: string; }
const { size = 14, label = '5 stelle su 5', class: className = '' } = Astro.props;
const path = 'M10 1.6l2.47 5.3 5.53.72-4.06 3.9 1.03 5.68L10 14.5l-4.97 2.7 1.03-5.68L2 7.62l5.53-.72L10 1.6z';
---
<span class={`inline-flex items-center gap-[3px] ${className}`} role="img" aria-label={label}>
  {Array.from({ length: 5 }).map(() => (
    <svg width={size} height={size} viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d={path}></path></svg>
  ))}
</span>
