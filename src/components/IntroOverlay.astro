---
/**
 * IntroOverlay — animazione d'ingresso con il logo, mostrata una volta a
 * sessione all'apertura del sito. Il CSS (.ag-intro) è in global.css.
 */
---
<div id="ag-intro" class="ag-intro" role="presentation" aria-hidden="true">
  <div class="flex flex-col items-center">
    <img class="ag-intro__logo" src="/images/logo/atelier-logo.png" alt="" width="416" height="145" fetchpriority="high" decoding="sync" />
    <span class="ag-intro__rule"></span>
  </div>
</div>

<script>
  (function () {
    const el = document.getElementById('ag-intro');
    if (!el) return;
    const root = document.documentElement;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let seen = false;
    try { seen = sessionStorage.getItem('ag-intro') === '1'; } catch {}
    if (seen || reduce) { el.remove(); return; }
    try { sessionStorage.setItem('ag-intro', '1'); } catch {}
    root.classList.add('ag-intro-lock');
    const done = () => { el.remove(); root.classList.remove('ag-intro-lock'); };
    el.addEventListener('animationend', (e) => {
      if ((e as AnimationEvent).animationName === 'ag-intro-out') done();
    });
    setTimeout(done, 3200); // fallback di sicurezza
  })();
</script>
