---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import IntroOverlay from '../components/IntroOverlay.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string; // [[DA COMPILARE: percorso immagine Open Graph, es. /images/og-default.jpg]]
  transparentHeader?: boolean;
  bodyClass?: string;
  noindex?: boolean;
}
const {
  title,
  description = "Atelier di Architettura — studio dell'arch. Ivan Gentilini a Ravenna: progettazione, ristrutturazioni e interior design.",
  ogImage = '/images/og-default.svg',
  transparentHeader = false,
  bodyClass = 'min-h-screen bg-paper',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.domain).href;
const ogImageAbs = ogImage ? new URL(ogImage, site.domain).href : '';

// JSON-LD organizzazione — valori segnaposto (da data/site). Al riempimento
// diventano i dati reali del cliente.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['ProfessionalService', 'HomeAndConstructionBusiness'],
  '@id': `${site.domain}/#organization`,
  name: site.name,
  legalName: site.legalName,
  description,
  url: `${site.domain}/`,
  email: site.email,
  telephone: site.phoneE164,
  foundingDate: site.foundingYear,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.addresses[0].street,
    postalCode: site.addresses[0].zip,
    addressLocality: site.addresses[0].city,
    addressRegion: site.addresses[0].province,
    addressCountry: 'IT',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  sameAs: site.socials.map((s) => s.url),
};
---
<!DOCTYPE html>
<html lang="it" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* theme-color = accent Atelier (proposta, da validare al Gate 0) */}
    <meta name="theme-color" content="#e4572e" />
    <meta name="format-detection" content="telephone=no" />
    <script is:inline>document.documentElement.classList.add('js');</script>

    {/* [[DA COMPILARE: favicon del cliente — sostituire favicon.svg e aggiungere i PNG/apple-touch ]] */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:locale" content="it_IT" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="author" content={site.name} />
    <meta name="geo.region" content={site.geo.region} />
    <meta name="geo.placename" content={site.city} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <IntroOverlay />
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[1001] bg-white text-ink px-4 py-2">Salta al contenuto</a>

    <Header transparent={transparentHeader} />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <WhatsAppFab />
    <CookieBanner />

    <script>
      const i=document.querySelectorAll(".reveal-in");if(!("IntersectionObserver"in window)||matchMedia("(prefers-reduced-motion: reduce)").matches)i.forEach(e=>e.classList.add("is-visible"));else{const e=new IntersectionObserver(s=>{s.forEach(r=>{r.isIntersecting&&(r.target.classList.add("is-visible"),e.unobserve(r.target))})},{threshold:.12,rootMargin:"0px 0px -40px 0px"});i.forEach(s=>e.observe(s))}
    </script>
  </body>
</html>
