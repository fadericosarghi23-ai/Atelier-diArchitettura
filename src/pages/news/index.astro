---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Placeholder from '../../components/Placeholder.astro';

// Elenco segnaposto di news / pubblicazioni.
const items = Array.from({ length: 4 }, (_, i) => i + 1);
---
<BaseLayout
  title="News e pubblicazioni — Atelier di Architettura"
  description="News, articoli e pubblicazioni di Atelier di Architettura."
>
  <PageHeader
    eyebrow="News"
    title="News e pubblicazioni"
    intro="Aggiornamenti, articoli e pubblicazioni dello studio."
  />

  <section class="container-site pb-20 md:pb-28">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-5 gap-y-10">
      {items.map((n) => (
        <article class="group reveal-in">
          <div class="relative overflow-hidden aspect-[3/2]">
            <Placeholder w={1200} h={800} label={`Copertina news ${n}`} class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]" />
          </div>
          <p class="mt-3 text-xs uppercase tracking-[.14em] text-grey">[[DA COMPILARE: data / testata news {n}]]</p>
          <h2 class="mt-1 font-heading text-h4 text-ink group-hover:text-accent transition-colors">[[DA COMPILARE: titolo news {n}]]</h2>
          <p class="mt-2 text-s text-body">[[DA COMPILARE: estratto news {n}, 1-2 frasi]]</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
