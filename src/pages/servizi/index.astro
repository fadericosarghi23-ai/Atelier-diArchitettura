---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Placeholder from '../../components/Placeholder.astro';
import { services } from '../../data/services';
---
<BaseLayout
  title="Servizi — Atelier di Architettura"
  description="I servizi di Atelier di Architettura a Ravenna: progettazione, ristrutturazioni, interior design, direzione lavori, render 3D, RTI e pratiche catastali."
>
  <PageHeader
    eyebrow="Servizi"
    title="I nostri servizi"
    intro="Progettazione, ristrutturazioni e interior design, dal concept al cantiere: i servizi con cui seguiamo case e spazi in ogni fase."
  />

  <div class="pb-10">
    {services.map((s, i) => (
      <section id={s.slug} class="scroll-mt-header py-12 md:py-16 odd:bg-sand-light">
        <div class="container-site grid lg:grid-cols-2 gap-8 md:gap-12 items-center">
          <div class={`relative overflow-hidden aspect-[4/3] reveal-in ${i % 2 ? 'lg:order-2' : ''}`}>
            <Placeholder w={1600} h={1200} label={`Foto servizio: ${s.slug}`} class="w-full h-full object-cover" />
          </div>
          <div class="reveal-in">
            <p class="eyebrow mb-3">Servizio {String(i + 1).padStart(2, '0')}</p>
            <h2 class="font-heading text-h2 text-ink">{s.title}</h2>
            <p class="mt-m text-body">{s.body}</p>
            <a href="/contatti/#richiedi" class="btn-outline mt-8">Richiedi informazioni</a>
          </div>
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
