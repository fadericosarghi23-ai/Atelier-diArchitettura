---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { site } from '../../data/site';
---
<BaseLayout
  title="Contatti — Atelier di Architettura"
  description="Contatta Atelier di Architettura a Ravenna: telefono, WhatsApp ed email per il tuo progetto."
>
  <PageHeader
    eyebrow="Contatti"
    title="Parliamo del tuo progetto"
    intro="Scrivici per raccontarci il tuo progetto: telefono, WhatsApp o modulo contatti. Ti rispondiamo per fissare un primo confronto."
  />

  <section class="container-site pb-20 md:pb-28 grid lg:grid-cols-12 gap-10">
    {/* Form */}
    <div id="richiedi" class="lg:col-span-7 reveal-in scroll-mt-header">
      <h2 class="font-heading text-h3 text-ink mb-6">Scrivici</h2>
      <form id="contact-form" method="POST" data-endpoint={site.formEndpoint} data-mailto={site.email} class="grid sm:grid-cols-2 gap-5">
        <label class="flex flex-col gap-1.5 text-s">
          <span class="text-ink font-medium">Nome e cognome</span>
          <input type="text" name="nome" required class="border border-ink/15 px-4 py-3 focus:border-accent outline-none transition-colors" />
        </label>
        <label class="flex flex-col gap-1.5 text-s">
          <span class="text-ink font-medium">Email</span>
          <input type="email" name="email" required class="border border-ink/15 px-4 py-3 focus:border-accent outline-none transition-colors" />
        </label>
        <label class="flex flex-col gap-1.5 text-s">
          <span class="text-ink font-medium">Telefono</span>
          <input type="tel" name="telefono" class="border border-ink/15 px-4 py-3 focus:border-accent outline-none transition-colors" />
        </label>
        <label class="flex flex-col gap-1.5 text-s">
          <span class="text-ink font-medium">Oggetto</span>
          <input type="text" name="oggetto" class="border border-ink/15 px-4 py-3 focus:border-accent outline-none transition-colors" />
        </label>
        <label class="sm:col-span-2 flex flex-col gap-1.5 text-s">
          <span class="text-ink font-medium">Messaggio</span>
          <textarea name="messaggio" rows="5" required class="border border-ink/15 px-4 py-3 focus:border-accent outline-none transition-colors"></textarea>
        </label>
        <label class="sm:col-span-2 flex items-start gap-3 text-s text-body">
          <input type="checkbox" name="privacy" required class="mt-1" />
          <span>Ho letto e accetto la <a href="/privacy-policy/" class="link-underline text-accent">privacy policy</a>.</span>
        </label>
        <div class="sm:col-span-2">
          <button type="submit" class="btn-primary">Invia richiesta</button>
          <p id="form-note" class="mt-3 text-s text-grey" hidden></p>
        </div>
      </form>
    </div>

    {/* Recapiti + mappa */}
    <aside class="lg:col-span-5 reveal-in">
      <div class="space-y-6 text-s">
        {site.addresses.map((a) => (
          <div>
            <p class="text-xs uppercase tracking-[.16em] text-grey">{a.label}</p>
            <p class="mt-1 text-ink">{a.full}</p>
          </div>
        ))}
        <div>
          <p class="text-xs uppercase tracking-[.16em] text-grey">Email e telefono</p>
          <p class="mt-1"><a href={`mailto:${site.email}`} class="link-underline text-ink">{site.email}</a></p>
          <p class="mt-1"><a href={`tel:${site.phoneE164}`} class="link-underline text-ink">{site.phoneDisplay}</a></p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-[.16em] text-grey">Orari</p>
          <p class="mt-1 text-ink">{site.hours}</p>
          <p class="text-grey">{site.hoursNote}</p>
        </div>
        <div class="relative overflow-hidden aspect-[4/3] mt-2">
          <iframe
            src="https://www.google.com/maps?q=Via%20di%20Roma%20268%2C%2048121%20Ravenna%20RA&output=embed"
            title="Mappa — Via di Roma 268, Ravenna"
            class="w-full h-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </aside>
  </section>

  <script>
    // Il form NON spedisce finché data-endpoint è vuoto: fallback mailto, così
    // nessun dato viene inviato a un servizio esterno non ancora ricollegato.
    const f = document.getElementById("contact-form") as HTMLFormElement | null;
    const note = document.getElementById("form-note");
    f?.addEventListener("submit", (e) => {
      const endpoint = f.dataset.endpoint?.trim();
      if (endpoint) { f.action = endpoint; return; }
      e.preventDefault();
      const data = new FormData(f);
      const subj = encodeURIComponent(String(data.get("oggetto") || "Richiesta dal sito"));
      const body = encodeURIComponent(
        `Nome: ${data.get("nome") || ""}\nEmail: ${data.get("email") || ""}\nTelefono: ${data.get("telefono") || ""}\n\n${data.get("messaggio") || ""}`
      );
      if (note) { note.hidden = false; note.textContent = "Apertura del client di posta… (endpoint del form non ancora collegato)."; }
      const to = f.dataset.mailto || "";
      window.location.href = `mailto:${to}?subject=${subj}&body=${body}`;
    });
  </script>
</BaseLayout>
