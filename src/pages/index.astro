---
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { site } from '../data/site';
import { steps } from '../data/process';
import { services } from '../data/services';
import { projects, catLabel } from '../data/projects';
import { faqs } from '../data/faq';

const homeProjects = projects.filter((p) => p.home);
const homeServices = services.filter((s) => s.home);
const faqCols = [faqs.slice(0, 5), faqs.slice(5, 10)];

// Immagini dello slider hero (cambiano in dissolvenza + Ken Burns).
const heroImages = [
  { src: '/images/hero/copertina-legno.jpg', w: 1440, h: 1800, alt: 'Soffitto in legno a vista restaurato — Atelier di Architettura' },
  { src: '/images/progetti/render-interni.jpg', w: 1440, h: 959, alt: 'Zona living — progetto Atelier di Architettura' },
  { src: '/images/progetti/render-01.jpg', w: 1065, h: 710, alt: 'Villa con giardino — progetto Atelier di Architettura' },
  { src: '/images/progetti/corte-cotignola.jpg', w: 1440, h: 1920, alt: 'Recupero corte a Cotignola' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title="Atelier di Architettura — Studio di architettura a Ravenna"
  description="Atelier di Architettura dell'arch. Ivan Gentilini a Ravenna: progettazione, ristrutturazione e direzione lavori, dal concept alla realizzazione."
  transparentHeader={true}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  {/* ============================= HERO ============================= */}
  <section class="relative min-h-svh flex items-end overflow-hidden bg-ink isolate">
    <div class="hero-slider absolute inset-0 -z-10" data-interval="5000">
      {heroImages.map((im, i) => (
        <figure class={`hero-slide absolute inset-0${i === 0 ? ' is-active' : ''}`} data-index={i}>
          <img src={im.src} alt={im.alt} width={im.w} height={im.h} class="w-full h-full object-cover"
               loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} decoding={i === 0 ? 'sync' : 'async'} />
        </figure>
      ))}
    </div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/90 via-ink/40 to-ink/20" aria-hidden="true"></div>

    <div class="relative z-10 container-site pb-16 md:pb-24 pt-header">
      <p class="eyebrow-light mb-5">Atelier di Architettura · Ravenna</p>
      <h1 class="font-heading font-normal text-white max-w-[18ch] text-[clamp(2.5rem,5.2vw+1rem,5.5rem)] leading-[1.03] tracking-[-.02em]">
        Non progettiamo spazi. <em class="italic text-sand">Diamo forma a visioni.</em>
      </h1>
      <p class="mt-7 max-w-2xl text-white/85 text-lg md:text-xl">Studio di architettura a Ravenna. Progettazione, ristrutturazione e direzione lavori, dal concept alla realizzazione.</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn-primary">Scrivici su WhatsApp</a>
        <a href="/portfolio/" class="btn-outline-light">Guarda i progetti</a>
      </div>
    </div>
  </section>

  <script>
    const c=document.querySelector(".hero-slider"),e=[...document.querySelectorAll(".hero-slide")];if(c&&e.length>1&&!matchMedia("(prefers-reduced-motion: reduce)").matches){const o=Number((c as HTMLElement).dataset.interval)||5e3;let t=0,s:number|undefined;const l=(a:number)=>{e[t]?.classList.remove("is-active"),t=a%e.length,e[t].classList.add("is-active");const n=e[(t+1)%e.length]?.querySelector("img");n&&n.loading==="lazy"&&(n.loading="eager")},r=()=>{i(),s=setInterval(()=>l(t+1),o)},i=()=>{if(s)clearInterval(s)};r(),document.addEventListener("visibilitychange",()=>document.hidden?i():r())}
  </script>

  {/* ======================= COME LAVORIAMO ======================= */}
  <section class="bg-sand-light py-14 md:py-20">
    <div class="container-site">
      <div class="max-w-2xl reveal-in">
        <p class="eyebrow mb-3">Metodo</p>
        <h2 class="font-heading text-h2 text-ink">Come lavoriamo</h2>
      </div>
      <div class="mt-10">
        <ol class="grid gap-px bg-ink/10 sm:grid-cols-2 lg:grid-cols-4">
          {steps.map((step, i) => (
            <li class="process-card group relative isolate flex flex-col min-h-[21rem] lg:min-h-[23rem] p-6 md:p-7 overflow-hidden bg-ink reveal-in" style={`transition-delay:${i * 50}ms`}>
              {step.src
                ? <img src={step.src} alt="" width={step.img.w} height={step.img.h} loading="lazy" decoding="async" class="absolute inset-0 -z-10 w-full h-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-105" />
                : <Placeholder w={step.img.w} h={step.img.h} label={step.img.label} class="absolute inset-0 -z-10 w-full h-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-105" />}
              <span class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/95 via-ink/70 to-ink/35 transition-colors duration-500 group-hover:from-ink group-hover:via-ink/75" aria-hidden="true"></span>
              <span class="grid place-items-center w-10 h-10 bg-accent text-white font-heading text-sm font-semibold shrink-0">{step.n}</span>
              <div class="mt-auto pt-8">
                <h3 class="font-heading text-h4 text-white leading-snug">{step.title}</h3>
                <p class="mt-2.5 text-s text-white/75">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <a href="/come-lavoriamo/" class="btn-outline mt-10">Scopri il metodo</a>
    </div>
  </section>

  {/* ============================ SERVIZI ============================ */}
  <section class="container-site py-16 md:py-24">
    <div class="grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-4 lg:self-center reveal-in">
        <p class="eyebrow mb-3">Servizi</p>
        <h2 class="font-heading text-h2 text-ink">Cosa facciamo</h2>
        <p class="mt-m text-body">Progettazione, ristrutturazioni, interior design e direzione lavori: seguiamo case e spazi dal primo schizzo alla consegna, con un unico riferimento in ogni fase.</p>
        <a href="/servizi/" class="btn-outline mt-8">Tutti i servizi</a>
      </div>
      <ul class="lg:col-span-8 grid sm:grid-cols-2 gap-px bg-ink/10">
        {homeServices.map((s, i) => (
          <li class="bg-white p-7 reveal-in" style={`transition-delay:${i * 60}ms`}>
            <ServiceIcon slug={s.slug} class="w-12 h-12 mb-4 text-ink" />
            <h3 class="font-heading text-h4 text-ink">
              <a href={`/servizi/#${s.slug}`} class="link-underline hover:text-accent transition-colors">{s.title}</a>
            </h3>
            <p class="mt-3 text-s text-body">{s.excerpt}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* =========================== PORTFOLIO =========================== */}
  <section class="container-site pb-16 md:pb-24">
    <div class="flex flex-wrap items-end justify-between gap-6 reveal-in">
      <div>
        <p class="eyebrow mb-3">Progetti</p>
        <h2 class="font-heading text-h2 text-ink">Lavori realizzati e progetti</h2>
      </div>
      <a href="/portfolio/" class="link-underline text-xs uppercase tracking-[.16em] font-semibold text-accent">Vai al portfolio</a>
    </div>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-4 md:gap-x-5 gap-y-7 md:gap-y-8">
      {homeProjects.map((p) => (
        <article class="group reveal-in">
          <a href={`/portfolio/${p.slug}/`} class="block focus-visible:outline-offset-4">
            <div class="relative overflow-hidden bg-grey-light aspect-[4/3]">
              {p.img
                ? <img src={p.img} alt={p.title} width={p.preview.w} height={p.preview.h} loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]" />
                : <Placeholder w={p.preview.w} h={p.preview.h} label={p.preview.label} class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]" />}
              <div class="absolute inset-0 bg-ink/0 group-hover:bg-ink/15 transition-colors duration-500" aria-hidden="true"></div>
            </div>
            <div class="pt-3">
              <h3 class="font-heading text-h4 text-ink leading-tight group-hover:text-accent transition-colors">{p.title}</h3>
              <p class="mt-0.5 text-s text-grey">{p.place}{p.year ? ` · ${p.year}` : ''}</p>
              <ul class="mt-2 flex flex-wrap gap-1.5" aria-label="Categorie del progetto">
                {p.tags.map((t) => (
                  <li class="text-[.625rem] uppercase tracking-[.12em] text-grey border border-ink/10 px-2 py-0.5">{catLabel(t)}</li>
                ))}
              </ul>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  {/* Sezione RECENSIONI rimossa: nessuna testimonianza utilizzabile (vedi mappa). */}

  {/* ============================== FAQ ============================== */}
  <section id="faq" class="container-site py-14 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-6 reveal-in">
      <div>
        <p class="eyebrow mb-3">FAQ</p>
        <h2 class="font-heading text-h2 text-ink">Domande frequenti</h2>
      </div>
      <a href="/contatti/#richiedi" class="link-underline text-xs uppercase tracking-[.16em] font-semibold text-accent">Hai un'altra domanda? Scrivici</a>
    </div>
    <div class="mt-8 grid md:grid-cols-2 gap-x-12">
      {faqCols.map((col) => (
        <div>
          {col.map((f, i) => (
            <details name="faq" class="group border-b border-ink/10 py-4 reveal-in" style={`transition-delay:${i * 40}ms`}>
              <summary class="flex items-start justify-between gap-6 cursor-pointer list-none">
                <h3 class="font-heading text-h4 text-ink group-open:text-accent transition-colors">{f.q}</h3>
                <span class="shrink-0 mt-1.5 w-4 h-4 relative before:absolute before:inset-x-0 before:top-1/2 before:h-px before:bg-current after:absolute after:inset-y-0 after:left-1/2 after:w-px after:bg-current after:transition-transform group-open:after:scale-y-0" aria-hidden="true"></span>
              </summary>
              <p class="mt-2.5 text-s text-body">{f.a}</p>
            </details>
          ))}
        </div>
      ))}
    </div>
  </section>

  {/* ============================ DOVE SIAMO ============================ */}
  <section id="contatti" class="scroll-mt-header py-16 md:py-24">
    <div class="container-site grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5 reveal-in">
        <p class="eyebrow mb-3">Dove siamo</p>
        <h2 class="font-heading text-h2 text-ink">Parliamo del tuo progetto</h2>
        <p class="mt-m text-body">Studio con base a Ravenna e attività a Cotignola. Raccontaci il tuo progetto: fissiamo un primo confronto per capire esigenze, tempi e budget.</p>
        <a href="/contatti/" class="btn-primary mt-8">Contattaci</a>
      </div>
      <div class="lg:col-span-7 grid sm:grid-cols-2 gap-8">
        <div>
          <p class="text-xs uppercase tracking-[.16em] text-grey">Contatti</p>
          <p class="mt-2 text-ink">{site.addresses[0].full}</p>
          <p class="mt-2 text-s"><a href={`mailto:${site.email}`} class="link-underline text-ink">{site.email}</a></p>
          <p class="mt-1 text-s"><a href={`tel:${site.phoneE164}`} class="link-underline text-ink">{site.phoneDisplay}</a></p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-[.16em] text-grey">Orari</p>
          <p class="mt-2 text-ink">{site.hours}</p>
          <p class="mt-1 text-s text-grey">{site.hoursNote}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
