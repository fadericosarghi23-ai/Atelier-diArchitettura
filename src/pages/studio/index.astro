---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Placeholder from '../../components/Placeholder.astro';
import { team } from '../../data/team';

const founders = team.filter((m) => m.founder);
const collaborators = team.filter((m) => !m.founder);
---
<BaseLayout
  title="Lo studio — Atelier di Architettura"
  description="Atelier di Architettura, studio dell'arch. Ivan Gentilini a Ravenna: architettura come equilibrio tra bellezza e funzionalità."
>
  <PageHeader
    eyebrow="Lo studio"
    title="Atelier di Architettura"
    intro="Atelier di Architettura è lo studio dell'architetto Ivan Gentilini, a Ravenna. Ci occupiamo di architettura, interior design e ristrutturazioni, seguendo ogni progetto dal primo incontro alla consegna del cantiere."
  />

  {/* Racconto + immagine */}
  <section class="container-site pb-16 md:pb-24 grid lg:grid-cols-12 gap-10 items-center">
    <div class="lg:col-span-6 relative overflow-hidden aspect-[4/3] reveal-in">
      <Placeholder w={1600} h={1200} label="Foto studio / progetto realizzato (da fornire)" class="w-full h-full object-cover" />
    </div>
    <div class="lg:col-span-6 reveal-in prose-dom">
      <p class="eyebrow mb-3">Chi siamo</p>
      <h2 class="font-heading text-h2 text-ink mb-m">Il nostro approccio</h2>
      <p>Ogni progetto nasce da un ascolto profondo: della luce, dei materiali, delle persone. Crediamo che l'architettura non sia un esercizio di stile, ma un gesto di equilibrio tra bellezza e funzionalità. Se stai immaginando il tuo spazio ideale, noi possiamo renderlo reale.</p>
      <p>Seguiamo ogni progetto con attenzione al dettaglio, ai materiali e alla luce, coordinando le fasi dal disegno alla realizzazione. Un unico riferimento, dall’idea al cantiere.</p>
    </div>
  </section>

  {/* Team */}
  <section class="bg-sand-light py-16 md:py-24">
    <div class="container-site">
      <div class="max-w-2xl reveal-in">
        <p class="eyebrow mb-3">Team</p>
        <h2 class="font-heading text-h2 text-ink">L'architetto</h2>
      </div>

      <div class="mt-10 grid sm:grid-cols-2 gap-8">
        {founders.map((m) => (
          <article id={m.name.toLowerCase().replace(/[^a-z]+/g, '-')} class="reveal-in scroll-mt-header">
            <div class="relative overflow-hidden aspect-[4/5] bg-white">
              <Placeholder w={m.img.w} h={m.img.h} label={m.img.label} class="w-full h-full object-cover" />
            </div>
            <h3 class="mt-4 font-heading text-h4 text-ink">{m.name}</h3>
            <p class="text-s text-accent">{m.role}</p>
            <p class="mt-2 text-s text-body">{m.bio}</p>
          </article>
        ))}
      </div>

      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {collaborators.map((m) => (
          <article class="reveal-in">
            <div class="relative overflow-hidden aspect-[4/5] bg-white">
              <Placeholder w={m.img.w} h={m.img.h} label={m.img.label} class="w-full h-full object-cover" />
            </div>
            <h3 class="mt-4 font-heading text-h5 text-ink">{m.name}</h3>
            <p class="text-s text-accent">{m.role}</p>
            <p class="mt-2 text-s text-body">{m.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
