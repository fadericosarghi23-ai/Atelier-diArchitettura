---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { footerNav } from '../../data/nav';
import { services } from '../../data/services';
import { projects } from '../../data/projects';
---
<BaseLayout
  title="Mappa del sito — Atelier di Architettura"
  description="Mappa del sito di Atelier di Architettura: tutte le pagine, i servizi e i progetti."
>
  <PageHeader eyebrow="Mappa del sito" title="Mappa del sito" />

  <section class="container-site pb-20 md:pb-28 grid sm:grid-cols-2 lg:grid-cols-3 gap-10">
    <div>
      <h2 class="font-heading text-h4 text-ink mb-3">Pagine</h2>
      <ul class="space-y-2 text-s">
        {footerNav.map((i) => (<li><a href={i.href} class="link-underline text-body hover:text-accent">{i.label}</a></li>))}
      </ul>
    </div>
    <div>
      <h2 class="font-heading text-h4 text-ink mb-3">Servizi</h2>
      <ul class="space-y-2 text-s">
        {services.map((s) => (<li><a href={`/servizi/#${s.slug}`} class="link-underline text-body hover:text-accent">{s.title}</a></li>))}
      </ul>
    </div>
    <div>
      <h2 class="font-heading text-h4 text-ink mb-3">Progetti</h2>
      <ul class="space-y-2 text-s">
        {projects.map((p) => (<li><a href={`/portfolio/${p.slug}/`} class="link-underline text-body hover:text-accent">{p.title}</a></li>))}
      </ul>
    </div>
    <div>
      <h2 class="font-heading text-h4 text-ink mb-3">Legali</h2>
      <ul class="space-y-2 text-s">
        <li><a href="/privacy-policy/" class="link-underline text-body hover:text-accent">Privacy policy</a></li>
        <li><a href="/cookie-policy/" class="link-underline text-body hover:text-accent">Cookie policy</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
