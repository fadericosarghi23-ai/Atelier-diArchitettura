---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Placeholder from '../../components/Placeholder.astro';
import { steps } from '../../data/process';
---
<BaseLayout
  title="Come lavoriamo — Atelier di Architettura"
  description="Il metodo di lavoro di Atelier di Architettura, dal primo incontro alla consegna."
>
  <PageHeader
    eyebrow="Metodo"
    title="Come lavoriamo"
    intro="Un metodo chiaro in quattro fasi, dall'ascolto iniziale alla consegna del cantiere."
  />

  <div class="pb-16 md:pb-24">
    {steps.map((step, i) => (
      <section class="py-10 md:py-14 odd:bg-sand-light">
        <div class="container-site grid lg:grid-cols-12 gap-8 md:gap-12 items-center">
          <div class={`lg:col-span-6 relative overflow-hidden aspect-[4/3] reveal-in ${i % 2 ? 'lg:order-2' : ''}`}>
            {step.src
              ? <img src={step.src} alt="" width={1067} height={1600} loading="lazy" decoding="async" class="w-full h-full object-cover" />
              : <Placeholder w={1600} h={1200} label={`Foto step ${step.n}`} class="w-full h-full object-cover" />}
          </div>
          <div class="lg:col-span-6 reveal-in">
            <span class="font-heading text-[3rem] leading-none text-accent">{step.n}</span>
            <h2 class="mt-3 font-heading text-h2 text-ink">{step.title}</h2>
            <p class="mt-m text-body">{step.text}</p>
          </div>
        </div>
      </section>
    ))}

    <div class="container-site text-center mt-14 reveal-in">
      <a href="/contatti/#richiedi" class="btn-primary">Iniziamo insieme</a>
    </div>
  </div>
</BaseLayout>
