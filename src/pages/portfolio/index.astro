---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Placeholder from '../../components/Placeholder.astro';
import { projects, categories, catLabel } from '../../data/projects';
---
<BaseLayout
  title="Progetti — Atelier di Architettura"
  description="I progetti di Atelier di Architettura a Ravenna: ristrutturazioni, interior e nuove realizzazioni."
>
  <PageHeader
    eyebrow="Progetti"
    title="Lavori realizzati e progetti"
    intro="Una selezione di lavori e progetti seguiti dallo studio."
  />

  <section class="container-site pb-20 md:pb-28">
    {/* Filtro categorie */}
    <div class="flex flex-wrap gap-2 reveal-in" role="group" aria-label="Filtra per categoria">
      <button type="button" class="filter-btn text-xs uppercase tracking-[.14em] font-semibold px-4 py-2 border transition-colors bg-ink text-white border-ink" data-filter="__all" aria-pressed="true">Tutti</button>
      {categories.map((c) => (
        <button type="button" class="filter-btn text-xs uppercase tracking-[.14em] font-semibold px-4 py-2 border transition-colors text-ink border-ink/15" data-filter={c.slug} aria-pressed="false">{c.label}</button>
      ))}
    </div>

    {/* Griglia progetti */}
    <div id="project-grid" class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-4 md:gap-x-5 gap-y-7 md:gap-y-8">
      {projects.map((p) => (
        <article class="group reveal-in" data-tags={p.tags.join(' ')} data-project={p.slug}>
          <a href={`/portfolio/${p.slug}/`} class="block focus-visible:outline-offset-4">
            <div class="relative overflow-hidden bg-grey-light aspect-[4/3]">
              {p.img
                ? <img src={p.img} alt={p.title} width={p.preview.w} height={p.preview.h} loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]" />
                : <Placeholder w={p.preview.w} h={p.preview.h} label={p.preview.label} class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]" />}
              <div class="absolute inset-0 bg-ink/0 group-hover:bg-ink/15 transition-colors duration-500" aria-hidden="true"></div>
            </div>
            <div class="pt-3">
              <h3 class="font-heading text-h4 text-ink leading-tight group-hover:text-accent transition-colors">{p.title}</h3>
              <p class="mt-0.5 text-s text-grey">{p.place}{p.year ? ` · ${p.year}` : ''}</p>
              <ul class="mt-2 flex flex-wrap gap-1.5" aria-label="Categorie del progetto">
                {p.tags.map((t) => (
                  <li class="text-[.625rem] uppercase tracking-[.12em] text-grey border border-ink/10 px-2 py-0.5">{catLabel(t)}</li>
                ))}
              </ul>
            </div>
          </a>
        </article>
      ))}
    </div>

    <p id="no-results" hidden class="mt-10 text-center text-body">Nessun progetto in questa categoria.</p>
  </section>

  <script>
    const o=document.querySelectorAll(".filter-btn"),n=document.querySelectorAll("#project-grid [data-tags]"),c=document.getElementById("no-results"),d=(s:Element)=>{o.forEach(t=>{const e=t===s;t.setAttribute("aria-pressed",String(e)),t.classList.toggle("bg-ink",e),t.classList.toggle("text-white",e),t.classList.toggle("border-ink",e),t.classList.toggle("border-ink/15",!e),t.classList.toggle("text-ink",!e)})};o.forEach(s=>{s.addEventListener("click",()=>{const t=(s as HTMLElement).dataset.filter;d(s);let e=0;n.forEach(l=>{const r=t==="__all"||((l as HTMLElement).dataset.tags??"").split(" ").includes(t as string);(l as HTMLElement).hidden=!r,r&&e++}),c&&(c.hidden=e>0);const a=new URL(location.href);t==="__all"?a.searchParams.delete("categoria"):a.searchParams.set("categoria",t as string),history.replaceState(null,"",a)})});const i=new URL(location.href).searchParams.get("categoria");i&&(document.querySelector(`.filter-btn[data-filter="${i}"]`) as HTMLElement|null)?.click();
  </script>
</BaseLayout>
