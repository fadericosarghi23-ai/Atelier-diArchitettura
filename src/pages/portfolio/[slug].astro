---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Placeholder from '../../components/Placeholder.astro';
import { projects, catLabel } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: { project: p, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
---
<BaseLayout
  title={`${project.title} — Atelier di Architettura`}
  description="Un progetto seguito da Atelier di Architettura: immagini e caratteristiche dell'intervento."
  transparentHeader={true}
>
  {/* Cover */}
  <section class="relative min-h-[70svh] flex items-end overflow-hidden bg-ink isolate">
    {project.img
      ? <img src={project.img} alt={project.title} width={project.cover.w} height={project.cover.h} loading="eager" fetchpriority="high" decoding="sync" class="absolute inset-0 -z-10 w-full h-full object-cover" />
      : <Placeholder w={project.cover.w} h={project.cover.h} label={`Cover — ${project.cover.label}`} class="absolute inset-0 -z-10 w-full h-full object-cover" loading="eager" fetchpriority="high" />}
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/90 via-ink/40 to-ink/10" aria-hidden="true"></div>
    <div class="relative z-10 container-site pb-12 md:pb-16 pt-header">
      <p class="eyebrow-light mb-3">{project.place}{project.year ? ` · ${project.year}` : ''}</p>
      <h1 class="font-heading text-white text-h1 max-w-[16ch]">{project.title}</h1>
    </div>
  </section>

  {/* Intro + fatti */}
  <section class="container-site py-14 md:py-20 grid lg:grid-cols-12 gap-10">
    <div class="lg:col-span-8 reveal-in prose-dom">
      <p class="text-lg">{project.intro}</p>
    </div>
    <aside class="lg:col-span-4 reveal-in">
      <dl class="grid grid-cols-2 gap-y-4 text-s">
        <dt class="text-grey uppercase tracking-[.14em] text-xs">Luogo</dt>
        <dd class="text-ink">{project.place}</dd>
        <dt class="text-grey uppercase tracking-[.14em] text-xs">Anno</dt>
        <dd class="text-ink">{project.year || '—'}</dd>
        <dt class="text-grey uppercase tracking-[.14em] text-xs">Categorie</dt>
        <dd class="text-ink">{project.tags.map((t) => catLabel(t)).join(', ')}</dd>
        <dt class="text-grey uppercase tracking-[.14em] text-xs">Superficie</dt>
        <dd class="text-ink">[[DA COMPILARE: superficie, es. "120 m²"]]</dd>
      </dl>
    </aside>
  </section>

  {/* Gallery */}
  <section class="container-site pb-16 md:pb-24">
    <div class="grid sm:grid-cols-2 gap-4 md:gap-5">
      {project.gallery.map((g, i) => (
        <figure class={`relative overflow-hidden reveal-in ${i % 3 === 0 ? 'sm:col-span-2 aspect-[16/9]' : 'aspect-[4/3]'}`}>
          {g.src
            ? <img src={g.src} alt={g.label} width={g.w} height={g.h} loading="lazy" decoding="async" class="w-full h-full object-cover" />
            : <Placeholder w={g.w} h={g.h} label={g.label} class="w-full h-full object-cover" />}
        </figure>
      ))}
    </div>
  </section>

  {/* Prossimo progetto */}
  <section class="bg-ink text-white">
    <a href={`/portfolio/${next.slug}/`} class="group block container-site py-14 md:py-20">
      <p class="eyebrow mb-3">Prossimo progetto</p>
      <h2 class="font-heading text-h1 text-white group-hover:text-accent transition-colors">{next.title} →</h2>
    </a>
  </section>
</BaseLayout>
